# Copy to .env.local (gitignored) and uncomment the ONE block you want.
# Vite auto-loads .env.local for `npm run dev` and `npm run build`.
# After editing this file, restart `npm run dev` to pick up changes.

# --- Mode 1: Local SPA + Local API (default) ----------------------------------
# Use this when running `dotnet run --project SmartFund.API --launch-profile http`.
# The HTTP profile binds only :5123 — Vite's default proxy target is :7274,
# so override it here.
VITE_API_PROXY_TARGET=http://localhost:5123

# --- Mode 2: Local SPA + Production API ---------------------------------------
# Bypass the proxy and call the Droplet API directly. The API allows this
# origin via Cors__AllowedOrigins (set to include http://localhost in dev).
# VITE_API_BASE_URL=https://164-90-170-223.sslip.io/api

# --- Mode 3: Local SPA + Droplet API via Vite proxy ---------------------------
# SPA calls /api same-origin; Vite proxies every /api/* call to the Droplet.
# VITE_API_PROXY_TARGET=https://164-90-170-223.sslip.io
