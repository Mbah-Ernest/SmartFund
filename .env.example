# SmartFund — production environment variables.
# Copy to `.env` on the Droplet (chmod 600). NEVER commit the real file.
# These are consumed by docker-compose.yml.

# --- SQL Server ---------------------------------------------------------------
# Must be 8+ chars and meet SQL Server complexity rules (upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=ChangeMe_Strong_Pa55!

# --- JWT ----------------------------------------------------------------------
# Use a 64+ character random string. Generate with:  openssl rand -base64 64
JWT_KEY=replace-with-a-long-random-secret-of-at-least-64-characters
JWT_ISSUER=SmartFund
JWT_AUDIENCE=SmartFund.Web
JWT_EXPIRES_MINUTES=480

# --- Legacy single-operator login (Auth section in appsettings) ---------------
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-strong-password

# --- Groq (LLM, OpenAI-compatible) --------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (Claude) -------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Mono (Open Banking) ------------------------------------------------------
MONO_PUBLIC_KEY=
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
MONO_BASE_URL=https://api.withmono.com

# --- CORS + HTTPS frontend ----------------------------------------------------
# Allowed CORS origins (semicolon-separated). Localhost is always allowed.
# Add the App Platform URL here so the SPA can call this API cross-origin.
CORS_ALLOWED_ORIGINS=https://smartfund-9tu9r.ondigitalocean.app

# Public hostname Caddy serves. Use <ip-with-dashes>.sslip.io for free HTTPS
# without owning a domain. Replace with a real domain when you have one.
CADDY_HOSTNAME=smartfund.ibuildmanagement.tech

# Optional secondary hostname Caddy also serves with TLS. Handy during DNS
# cut-overs — set to your old hostname to avoid a downtime window.
CADDY_HOSTNAME_FALLBACK=164-90-170-223.sslip.io
