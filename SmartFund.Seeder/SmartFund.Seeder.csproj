    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmartFund.Seeder</RootNamespace>
    <AssemblyName>SmartFund.Seeder</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartFund.Persistence\SmartFund.Persistence.csproj" />
